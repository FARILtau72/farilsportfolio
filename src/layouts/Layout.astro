---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio Faril Putra Pratama - Python Enthusiast & Web Developer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-darker text-light font-sans overflow-x-hidden">
    <slot />
    <script src="../scripts/three-scene.js"></script>
    <script src="../scripts/i18n.js"></script>
    <script>
      // Listen for langchange and reload page content
      window.addEventListener('langchange', () => {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          const lang = localStorage.getItem('lang') || 'id';
          if (window.i18n && window.i18n[key] && window.i18n[key][lang]) {
            el.innerHTML = window.i18n[key][lang];
          }
        });
      });
      // On load, trigger langchange
      window.dispatchEvent(new Event('langchange'));
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body.bg-darker {
    background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #0f0f23 100%);
    min-height: 100vh;
  }
  body.bg-white {
    background: #fff;
    min-height: 100vh;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #0a0a1a;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #6366f1, #8b5cf6);
    border-radius: 4px;
  }

  ::selection {
    background: rgba(99, 102, 241, 0.3);
    color: #fff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .glass {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  html.light .glass, body.bg-white .glass {
    background: rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #222;
  }

  html.light .gradient-text, body.bg-white .gradient-text {
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #4f46e5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  html.light .text-light, body.bg-white .text-light {
    color: #222 !important;
  }
  html.light .text-light\/60, body.bg-white .text-light\/60 {
    color: #444 !important;
  }
  html.light .text-light\/70, body.bg-white .text-light\/70 {
    color: #555 !important;
  }
  html.light .text-light\/40, body.bg-white .text-light\/40 {
    color: #888 !important;
  }
  html.light .text-white, body.bg-white .text-white {
    color: #222 !important;
  }
  html.light .bg-white\/5, body.bg-white .bg-white\/5 {
    background-color: rgba(0,0,0,0.04) !important;
  }
  html.light .bg-white\/10, body.bg-white .bg-white\/10 {
    background-color: rgba(0,0,0,0.08) !important;
  }
  html.light .border-white\/10, body.bg-white .border-white\/10 {
    border-color: rgba(0,0,0,0.08) !important;
  }
  html.light .placeholder-light\/40, body.bg-white .placeholder-light\/40 {
    color: #aaa !important;
  }

  .glow-border {
    position: relative;
  }

  .glow-border::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glow-border:hover::before {
    opacity: 1;
  }
</style>
