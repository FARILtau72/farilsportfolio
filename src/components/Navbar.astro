---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
    <div class="glass rounded-2xl px-4 sm:px-6 py-3 flex items-center justify-between">
      <a href="#" class="text-lg sm:text-xl font-bold gradient-text">
        &lt;Faril /&gt;
      </a>
      
      <div class="hidden md:flex items-center gap-8">
        <a href="#home" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Home</a>
        <a href="#about" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">About</a>
        <a href="#skills" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Skills</a>
        <a href="#projects" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Projects</a>
        <a href="#contact" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Contact</a>
      </div>

      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <button id="lang-toggle" class="px-3 py-1 rounded-lg bg-white/10 text-xs text-light/80 hover:bg-primary/30 transition-all">ID/EN</button>
        <!-- Theme Switcher -->
        <button id="theme-toggle" class="px-3 py-1 rounded-lg bg-white/10 text-xs text-light/80 hover:bg-primary/30 transition-all flex items-center gap-1">
          <span id="theme-icon" class="">🌙</span>
        </button>
        <!-- Mobile menu -->
        <button id="menu-toggle" class="md:hidden text-light p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden mt-2 glass rounded-2xl p-4">
      <div class="flex flex-col gap-4">
        <a href="#home" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Home</a>
        <a href="#about" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">About</a>
        <a href="#skills" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Skills</a>
        <a href="#projects" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Projects</a>
        <a href="#contact" class="nav-link text-light/70 dark:text-light/70 light:text-dark/70 hover:text-light dark:hover:text-light light:hover:text-dark transition-colors duration-300 text-sm font-medium">Contact</a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // Navbar scroll effect
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar?.classList.add('py-2');
    } else {
      navbar?.classList.remove('py-2');
    }
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');
  function setTheme(mode) {
    const html = document.documentElement;
    if (mode === 'light') {
      document.body.classList.remove('bg-darker', 'text-light');
      document.body.classList.add('bg-white', 'text-gray-900');
      html.style.background = '#fff';
      html.style.color = '#111827';
      themeIcon.textContent = '☀️';
      localStorage.setItem('theme', 'light');
    } else {
      document.body.classList.remove('bg-white', 'text-gray-900');
      document.body.classList.add('bg-darker', 'text-light');
      html.style.background = 'linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #0f0f23 100%)';
      html.style.color = '#e2e8f0';
      themeIcon.textContent = '🌙';
      localStorage.setItem('theme', 'dark');
    }
  }
  themeToggle?.addEventListener('click', () => {
    const current = localStorage.getItem('theme') || 'dark';
    setTheme(current === 'dark' ? 'light' : 'dark');
  });
  // On load
  setTheme(localStorage.getItem('theme') || 'dark');

  // Language toggle
  const langToggle = document.getElementById('lang-toggle');
  langToggle?.addEventListener('click', () => {
    const lang = localStorage.getItem('lang') === 'en' ? 'id' : 'en';
    localStorage.setItem('lang', lang);
    window.dispatchEvent(new Event('langchange'));
  });
  // On load, set lang if not set
  if (!localStorage.getItem('lang')) localStorage.setItem('lang', 'id');
</script>
