---
---

<section id="about" class="py-32 relative">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-primary font-mono text-sm mb-4" data-i18n="about_gettoknow">// GET TO KNOW ME</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-4" data-i18n="about_title">
        <span class="text-light dark:text-light light:text-dark">About</span>
        <span class="gradient-text"> Me</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-primary to-secondary mx-auto rounded-full"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Profile Card -->
      <div class="relative group">
        <div class="absolute inset-0 bg-gradient-to-r from-primary to-secondary rounded-3xl blur-xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
        <div class="relative glass rounded-3xl p-8 overflow-hidden">
          <!-- Decorative Elements -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/20 to-transparent rounded-bl-full"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-secondary/20 to-transparent rounded-tr-full"></div>
          
          <!-- Profile Image Placeholder with Animated Border -->
          <div class="relative w-48 h-48 mx-auto mb-8">
            <div class="absolute inset-0 bg-gradient-to-r from-primary via-secondary to-primary rounded-full animate-spin" style="animation-duration: 3s;"></div>
            <div class="absolute inset-1 bg-darker rounded-full"></div>
            <div class="absolute inset-2 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-full flex items-center justify-center">
              <img src="./img/mysaya.jpg" alt="Profile" class="w-44 h-44 rounded-full object-cover border-4 border-white shadow-lg" />
            </div>
          </div>

          <!-- Info Cards -->
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/5 dark:bg-white/5 light:bg-black/5 rounded-xl p-4 text-center">
              <p class="text-3xl font-bold gradient-text">32+</p>
              <p class="text-light/60 dark:text-light/60 light:text-dark/60 text-sm">Repositories</p>
            </div>
            <div class="bg-white/5 dark:bg-white/5 light:bg-black/5 rounded-xl p-4 text-center">
              <p class="text-3xl font-bold gradient-text">150+</p>
              <p class="text-light/60 dark:text-light/60 light:text-dark/60 text-sm">Contributions</p>
            </div>
            <div class="bg-white/5 dark:bg-white/5 light:bg-black/5 rounded-xl p-4 text-center">
              <p class="text-3xl font-bold gradient-text">2</p>
              <p class="text-light/60 dark:text-light/60 light:text-dark/60 text-sm">Followers</p>
            </div>
            <div class="bg-white/5 dark:bg-white/5 light:bg-black/5 rounded-xl p-4 text-center">
              <p class="text-3xl font-bold gradient-text">7</p>
              <p class="text-light/60 dark:text-light/60 light:text-dark/60 text-sm">Following</p>
            </div>
          </div>
        </div>
      </div>

      <!-- About Content -->
      <div class="space-y-6">
        <div class="glass rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-gradient-to-r from-primary to-secondary rounded-lg flex items-center justify-center">
              <span class="text-xl">🎓</span>
            </div>
            <h3 class="text-xl font-semibold text-light dark:text-light light:text-dark" data-i18n="about_education">Education</h3>
          </div>
          <p class="text-light/70 dark:text-light/70 light:text-dark/70 leading-relaxed" data-i18n="about_education_desc">
            Siswa SMK Kelas 10 jurusan Rekayasa Perangkat Lunak di <strong class="text-primary">SMK Taruna Bangsa</strong>, Bekasi. 
            Saat ini juga aktif belajar di <strong class="text-secondary">IDCamp 2025</strong> program dari Dicoding & Indosat.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-gradient-to-r from-primary to-secondary rounded-lg flex items-center justify-center">
              <span class="text-xl">💼</span>
            </div>
            <h3 class="text-xl font-semibold text-light dark:text-light light:text-dark" data-i18n="about_experience">Experience</h3>
          </div>
          <p class="text-light/70 dark:text-light/70 light:text-dark/70 leading-relaxed" data-i18n="about_experience_desc">
            Volunteer Staff at <strong class="text-primary">Cosmic Security</strong>. 
            Passionate about Python programming dan web development. 
            Suka explore teknologi baru dan membangun project-project menarik.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-gradient-to-r from-primary to-secondary rounded-lg flex items-center justify-center">
              <span class="text-xl">🎯</span>
            </div>
            <h3 class="text-xl font-semibold text-light dark:text-light light:text-dark" data-i18n="about_goal">Goals</h3>
          </div>
          <p class="text-light/70 dark:text-light/70 light:text-dark/70 leading-relaxed" data-i18n="about_goal_desc">
            Menjadi Full-Stack Developer yang handal, mendalami Python untuk AI/ML, 
            dan berkontribusi dalam open source community. Dream big, start small! 🚀
          </p>
        </div>
      </div>
    </div>
</div>
  <div class="text-center mt-8">
    <span class="inline-block px-4 py-2 bg-white/10 dark:bg-white/10 light:bg-black/10 rounded-full text-xs text-light/60 dark:text-light/60 light:text-dark/60 font-mono tracking-wide" data-i18n="about_notai">Bukan buatan AI</span>
  </div>
</section>
